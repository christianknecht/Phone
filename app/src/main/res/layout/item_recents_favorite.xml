<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/item_recents_favorite_holder"
    android:layout_width="@dimen/recents_favorite_width"
    android:layout_height="wrap_content"
    android:background="@drawable/ripple_all_corners"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/small_margin">

    <ImageView
        android:id="@+id/item_recents_favorite_image"
        android:layout_width="@dimen/recents_favorite_avatar_size"
        android:layout_height="@dimen/recents_favorite_avatar_size"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_person_vector" />

    <TextView
        android:id="@+id/item_recents_favorite_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/small_margin"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:importantForAccessibility="no"
        android:maxLines="1"
        tools:text="John Doe" />

</LinearLayout>
